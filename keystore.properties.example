# Keystore bilgileri ortam değişkeni olarak verilir (CI secrets).
# Lokal geliştirmede ~/.gradle/gradle.properties içine yazılabilir:
#
#   MIM_STORE_FILE=/root/mim-project/android/keys/mim-release.jks
#   MIM_STORE_PASSWORD=...
#   MIM_KEY_ALIAS=mim
#   MIM_KEY_PASSWORD=...
#
# Bu dosya SAYI DEĞER İÇERMEZ — sırlar sadece ortamda/b secrets'ta tutulur.
